    "axis = eq.get_axis()\n",
    "\n",
    "eq1 = eq.copy()\n",
    "#pdb.set_trace()\n",
    "\n",
    "grid0 = LinearGrid(rho=result)\n",
    "Psi = eq.compute(\"Psi\", grid=grid0)[\"Psi\"]\n",
    "\n",
    "##eq_new = Equilibrium(Psi=Psi.item()/(2*np.pi), surface=surface)\n",
