# Nonlinear ITG turbulence with adiabatic electrons.
# Geometry scan: case=SLNAM_BEST, alpha=0.25 pi.

debug = false

[Dimensions]
ntheta = 640
nperiod = 1
ny = 96
nx = 96
nhermite = 8
nlaguerre = 4
nspecies = 1

[Domain]
y0 = 21.0
boundary = "linked"

[Physics]
beta = 0.0
nonlinear_mode = true

[Time]
t_max = 1200.0
dt = 0.1
cfl = 1.0
scheme = "rk3"

[Initialization]
ikpar_init = 0
init_field = "density"
init_amp = 1.0e-3

[Geometry]
geo_option = "nc"
geo_file = "/pscratch/sd/r/rgaur/mirrors/SLAM/SLAM-A-post-process/GVEC_GX/data/gx_geometry_gvec_SLNAM_BEST_rho0p650_npol5_nt641_alpha0p25pi.eik.nc"

[species]
z     = [ 1.0,      -1.0    ]
mass  = [ 1.0,       2.7e-4 ]
dens  = [ 1.0,       1.0    ]
temp  = [ 1.0,       1.0    ]
tprim = [ 1.250000,       0.0    ]
fprim = [ 1.000000,       0.0    ]
vnewk = [ 0.01,      0.0    ]
type  = [ "ion",  "electron" ]

[Boltzmann]
add_Boltzmann_species = true
Boltzmann_type = "electrons"
tau_fac = 1.0

[Dissipation]
closure_model = "none"
hypercollisions = true
hyper = true
D_hyper = 0.05

[Restart]
restart = false
save_for_restart = true

[Diagnostics]
nwrite = 50
free_energy = true
fluxes = true
fields = true
moments = true
