# Nonlinear ITG turbulence with adiabatic electrons.
# Geometry scan: case=QI_precursor, alpha0p625pi, a/LTi=1.5.

debug = false

[Dimensions]
ntheta = 640
nperiod = 1
ny = 96
nx = 96
nhermite = 8
nlaguerre = 4
nspecies = 1

[Domain]
y0 = 21.0
boundary = "linked"

[Physics]
beta = 0.0
nonlinear_mode = true

[Time]
t_max = 600.0
dt = 0.1
cfl = 1.0
scheme = "rk3"

[Initialization]
ikpar_init = 0
init_field = "density"
init_amp = 1.0e-3

[Geometry]
geo_option = "nc"
geo_file = "../../../../../data/gx_geometry_vmec_QI_precursor_ns512_rho0p650_npol5_nt641_alpha0p625pi.eik.nc"

[species]
z     = [ 1.0,      -1.0    ]
mass  = [ 1.0,       2.7e-4 ]
dens  = [ 1.0,       1.0    ]
temp  = [ 1.0,       1.0    ]
tprim = [ 1.500000,       0.0    ]
fprim = [ 1.000000,       0.0    ]
vnewk = [ 0.01,      0.0    ]
type  = [ "ion",  "electron" ]

[Boltzmann]
add_Boltzmann_species = true
Boltzmann_type = "electrons"
tau_fac = 1.0

[Dissipation]
closure_model = "none"
hypercollisions = true
hyper = true
D_hyper = 0.05

[Restart]
restart = false
save_for_restart = true

[Diagnostics]
nwrite = 50
free_energy = true
fluxes = true
fields = true
moments = true
